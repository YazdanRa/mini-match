{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bootstrap-sha": "37394010310d55d45043c40abfc6c6fc7ebd6418",
  "initial-version": "0.1.0",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "build",
      "section": "Dependencies and Build"
    },
    {
      "type": "ci",
      "section": "Continuous Integration"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "chore",
      "section": "Chores"
    },
    {
      "type": "refactor",
      "section": "Code Refactoring"
    },
    {
      "type": "bump",
      "section": "Version Bumps"
    },
    {
      "type": "revert",
      "section": "Reverts"
    }
  ],
  "packages": {
    "services/api": {
      "component": "server"
    },
    "apps/apple/MiniMatch": {
      "component": "apple",
      "extra-files": [
        {
          "type": "generic",
          "path": "MiniMatch.xcodeproj/project.pbxproj"
        }
      ]
    },
    "apps/web": {
      "component": "web"
    }
  }
